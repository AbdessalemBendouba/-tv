{
  "manifest_version": 3,
  "name": "حي على الصلاة",
  "version": "1.0",
  "description": "Mawaqit daily prayer times fetcher with Athan, Badges, and Notifications.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.mawaqit.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}